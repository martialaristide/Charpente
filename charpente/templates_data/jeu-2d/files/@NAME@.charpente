from charpente import *

with Workspace("@NAME@", version="0.1.0") as ws:
    ws.configurations(["Debug", "Release"])
    ws.requires("glfw@^3.4")

    with Target("@IDENT@_game") as game:            # the rules of the game: no window, no OpenGL, testable anywhere
        game.kind(Kind.STATIC_LIBRARY)
        game.standard("c++17")
        game.sources(["src/game/*.cpp"])
        game.public_include_dirs(["src/game"])

    with Target("@NAME@") as app:
        app.kind(Kind.EXECUTABLE)
        app.standard("c++17")
        app.sources(["src/main.cpp"])
        app.uses("@IDENT@_game", "glfw")
        with app.on_platform("windows-*") as windows:
            windows.links(["opengl32"])
        with app.on_platform("linux-*") as linux:
            linux.links(["GL"])
        with app.on_platform("macos-*") as mac:
            mac.link_flags(["-framework", "Cocoa", "-framework", "IOKit", "-framework", "CoreVideo", "-framework", "OpenGL"])

    with Target("@IDENT@_tests") as tests:
        tests.kind(Kind.TEST)
        tests.standard("c++17")
        tests.sources(["tests/*.cpp"])
        tests.uses("@IDENT@_game")
