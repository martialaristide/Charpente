from charpente import *

with Workspace("@NAME@", version="0.1.0") as ws:
    ws.configurations(["Debug", "Release"])
    ws.platforms(["wasm32-wasi"])

    with Target("@NAME@") as t:
        t.kind(Kind.EXECUTABLE)                 # a .wasm command; wasmtime, Node's WASI or any WASI host runs it
        t.standard("c++17")
        t.sources(["src/*.cpp"])
