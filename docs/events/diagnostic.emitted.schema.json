{
  "$id": "https://charpente.dev/schemas/events/v1/diagnostic.emitted.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "minimum": 1,
      "type": "integer"
    },
    "parent_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "type": [
            "integer",
            "null"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "fix": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "message"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "type": {
      "const": "diagnostic.emitted"
    },
    "wall_time": {
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "parent_id",
    "timestamp",
    "wall_time",
    "session_id",
    "type",
    "payload"
  ],
  "title": "diagnostic.emitted",
  "type": "object"
}
