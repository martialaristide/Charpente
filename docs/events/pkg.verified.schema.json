{
  "$id": "https://charpente.dev/schemas/events/v1/pkg.verified.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "minimum": 1,
      "type": "integer"
    },
    "parent_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "digest": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "type": {
      "const": "pkg.verified"
    },
    "wall_time": {
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "parent_id",
    "timestamp",
    "wall_time",
    "session_id",
    "type",
    "payload"
  ],
  "title": "pkg.verified",
  "type": "object"
}
